# Copy to .env for local development (never commit the real file).
# In production these are set in Vercel → Project → Settings → Environment Variables.

# Required — the shared password for /admin
ADMIN_PASSWORD=change-me

# Required — random string used to sign admin session cookies
SESSION_SECRET=change-me-too

# Set automatically when you connect a Redis store to the Vercel
# project (Storage tab → Create Database → Redis, Free plan). Leave
# unset locally and the app falls back to a local JSON file in .data/
# for development.
REDIS_URL=
